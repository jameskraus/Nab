{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nab.invalid/schemas/pending-list-v1.schema.json",
  "title": "NAB normalized YNAB pending list v1",
  "description": "Closed structural schema for PendingListResultV1. Ordering, alias uniqueness, byte ceilings, cross-record observation time equality, and date ordering are semantic constraints described in the protocol and fixture README.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_ref", "records", "snapshot", "warnings", "ordered_by"],
  "properties": {
    "schema": {
      "const": "nab.pending-list/1"
    },
    "plan_ref": {
      "$ref": "#/$defs/planRef"
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "pending-transaction-v1.schema.json"
      }
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1,
      "items": {
        "const": "UNMAPPED_ACCOUNT"
      }
    },
    "ordered_by": {
      "const": "date_desc_then_private_ref_asc"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "records": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["records"]
      },
      "then": {
        "properties": {
          "warnings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "warnings": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "planRef": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "fullDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "ynab_sync_age_ms",
        "sync_in_progress",
        "bootstrap_complete",
        "backfill_complete",
        "complete_for_materialized_snapshot",
        "materialized_first_date",
        "materialized_last_date",
        "provider_retention_guaranteed",
        "source"
      ],
      "properties": {
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "ynab_sync_age_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sync_in_progress": {
          "const": false
        },
        "bootstrap_complete": {
          "const": true
        },
        "backfill_complete": {
          "const": true
        },
        "complete_for_materialized_snapshot": {
          "const": true
        },
        "materialized_first_date": {
          "oneOf": [
            {
              "$ref": "#/$defs/fullDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "materialized_last_date": {
          "oneOf": [
            {
              "$ref": "#/$defs/fullDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_retention_guaranteed": {
          "const": false
        },
        "source": {
          "enum": ["page-snapshot", "browser-catalog"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "materialized_first_date": {
              "$ref": "#/$defs/fullDate"
            },
            "materialized_last_date": {
              "$ref": "#/$defs/fullDate"
            }
          }
        },
        {
          "properties": {
            "materialized_first_date": {
              "type": "null"
            },
            "materialized_last_date": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
