{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nab.invalid/schemas/broker-request-v1.schema.json",
  "title": "NAB browser bridge broker request v1",
  "description": "Closed structural schema for BrokerRequestV1. Pairing generation/epoch equality with the fixed credential and steady-state manifest, time ordering, the 30-second validity window, HMAC verification, nonce replay protection, consent-bound reference checks, and since/until ordering are semantic checks outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pairing_generation",
    "pairing_epoch",
    "request_id",
    "issued_at",
    "expires_at",
    "nonce",
    "auth_tag",
    "operation",
    "params"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "pairing_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pairing_epoch": {
      "$ref": "#/$defs/uuidV4"
    },
    "request_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "issued_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "nonce": {
      "$ref": "#/$defs/base64urlSha256"
    },
    "auth_tag": {
      "$ref": "#/$defs/base64urlSha256"
    },
    "operation": {
      "enum": ["bridge.ping", "session.status", "pending.list", "pending.get", "session.disconnect"]
    },
    "params": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "bridge.ping"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "session.status"
        },
        "params": {
          "$ref": "#/$defs/sessionStatusParams"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "pending.list"
        },
        "params": {
          "$ref": "#/$defs/pendingListParams"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "pending.get"
        },
        "params": {
          "$ref": "#/$defs/pendingGetParams"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "session.disconnect"
        },
        "params": {
          "$ref": "#/$defs/disconnectParams"
        }
      }
    }
  ],
  "$defs": {
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "fullDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "base64urlSha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "minLength": 43,
      "maxLength": 43
    },
    "planRef": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "privateTransactionRef": {
      "type": "string",
      "pattern": "^ynp1_[A-Za-z0-9_-]{43}$",
      "maxLength": 512
    },
    "privateAccountRef": {
      "type": "string",
      "pattern": "^yna1_[A-Za-z0-9_-]{43}$",
      "maxLength": 512
    },
    "emptyParams": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "sessionStatusParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_ref": {
          "$ref": "#/$defs/planRef"
        }
      }
    },
    "pendingListParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ref"],
      "properties": {
        "plan_ref": {
          "$ref": "#/$defs/planRef"
        },
        "private_account_ref": {
          "$ref": "#/$defs/privateAccountRef"
        },
        "since_date": {
          "$ref": "#/$defs/fullDate"
        },
        "until_date": {
          "$ref": "#/$defs/fullDate"
        },
        "include_entered_provisional": {
          "type": "boolean"
        },
        "max_ynab_sync_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "pendingGetParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ref", "private_entity_ref"],
      "properties": {
        "plan_ref": {
          "$ref": "#/$defs/planRef"
        },
        "private_entity_ref": {
          "$ref": "#/$defs/privateTransactionRef"
        },
        "include_entered_provisional": {
          "type": "boolean"
        }
      }
    },
    "disconnectParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remove_optional_permissions",
        "sign_out_dedicated_profile",
        "delete_dedicated_profile"
      ],
      "properties": {
        "remove_optional_permissions": {
          "type": "boolean"
        },
        "sign_out_dedicated_profile": {
          "type": "boolean"
        },
        "delete_dedicated_profile": {
          "type": "boolean"
        }
      }
    }
  }
}
